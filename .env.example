# Copy to .env (same folder) and fill in. Real environment variables take precedence over this file.

# Which model backend to use: openai (default) or ollama. The --backend flag on any command overrides this.
# BACKBONE_BACKEND=openai

# --- openai backend: either set the key directly...
OPENAI_API_KEY=your-key-here
# ...or point to a file that contains it (a bare key, or OPENAI_API_KEY=... lines)
# OPENAI_KEY_FILE=/path/to/keyfile.txt

# Optional: override per-1M-token prices (defaults are gpt-6-luna standard: 0.10 / 0.01 / 0.50)
# BACKBONE_PRICE_IN_PER_M=0.10
# BACKBONE_PRICE_CACHED_IN_PER_M=0.01
# BACKBONE_PRICE_OUT_PER_M=0.50

# --- ollama backend: no key needed
# OLLAMA_HOST_URL=http://127.0.0.1:11434
# BACKBONE_EXTRACT_MODEL=qwen3.5:9b
# BACKBONE_ANSWER_MODEL=qwen3.5:9b
